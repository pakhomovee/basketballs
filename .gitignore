# OS / editor
.DS_Store
.vscode/
.idea/
.venv/

# Python caches (from local tooling, if any)
__pycache__/
*.pyc

# Node / misc (not used by the static site, but harmless to ignore)
node_modules/
*.log

# Broadcast clip videos are NOT committed (third-party copyright).
# They are supplied at deploy time (e.g. uploaded to the host directly).
data/*/video.mp4
